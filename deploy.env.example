# Kopieren nach deploy.env und ausfüllen (deploy.env wird NICHT ins Git eingecheckt)

# ftps = FTP mit TLS-Verschlüsselung (Passwort nötig)
# sftp = Übertragung über SSH mit Schlüssel (kein Passwort nötig; SSH-Zugang muss beim Hoster aktiv sein)
PROTOKOLL=ftps

FTP_HOST=wXXXXXXX.kasserver.com
FTP_USER=benutzername
FTP_PASS=passwort
# Zielordner auf dem Server, leer lassen für das Hauptverzeichnis des Zugangs
FTP_DIR=

# Nur für die Testseite dev.kita-neufang.de (deploy.ps1 -Dev):
# Zielordner der Subdomain auf dem Server (im KAS als Ziel der Subdomain eingetragen)
DEV_DIR=/kita-static-dev
# Zugang zur Testseite (Browser fragt danach); deploy.ps1 erzeugt daraus die .htpasswd
DEV_USER=kita
DEV_PASS=passwort
# Absoluter Serverpfad der .htpasswd (bei ALL-INKL: /www/htdocs/<KAS-Login>/<DEV_DIR>/.htpasswd)
DEV_HTPASSWD=/www/htdocs/wXXXXXXX/kita-static-dev/.htpasswd
# Geheimer Teil des Freischalt-Links https://dev.kita-neufang.de/?zugang=<DEV_ZUGANG>
# (setzt ein Cookie für 1 Jahr, danach keine Passwortabfrage mehr). Mind. 20 Buchstaben/Ziffern.
# Ändern sperrt alle bisher freigeschalteten Browser wieder aus.
DEV_ZUGANG=zufaelligeZeichenkette123

# Nur für SFTP (optional):
# SFTP_PORT=22
# SFTP_KEY=C:\Users\Roland\.ssh\id_ed25519
